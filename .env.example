# ═══════════════════════════════════════════════════
# Djibril AI Trading System — Environment Variables
# ═══════════════════════════════════════════════════

# ── Anthropic Claude API ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-6

# ── NewsAPI ──
NEWSAPI_KEY=your_newsapi_key_here

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# ── Discord Webhook (optional) ──
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# ── Twitter/X API v2 (optional) ──
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── Alpha Vantage (fallback for yfinance) ──
ALPHAVANTAGE_API_KEY=your_alpha_vantage_key

# ── FastAPI Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=djibril-secret-key-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──
DATABASE_URL=sqlite:///djibril.db
# For production: DATABASE_URL=postgresql://user:pass@localhost:5432/djibril

# ── Redis (optional cache) ──
REDIS_URL=redis://localhost:6379/0

# ── Trading Parameters ──
ACCOUNT_BALANCE=10000.0
MAX_RISK_PER_TRADE=0.05
DEFAULT_WIN_RATE=0.55
AVG_WIN_LOSS_RATIO=1.67
MAX_SPREAD_POINTS=50
MAGIC_NUMBER=202503

# ── Signal Parameters ──
SIGNAL_OUTPUT_DIR=./mql5/signals
SIGNAL_TIMEOUT_SECONDS=300
SCAN_INTERVAL_MINUTES=2
SCORING_INTERVAL_MINUTES=5
SIGNAL_CHECK_INTERVAL_SECONDS=30

# ── Logging ──
LOG_LEVEL=INFO
LOG_DIR=./logs
